rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /properties/{propertyId} {
      // Público puede leer
      allow read: if true;
      // Solo admin autenticado puede escribir/modificar
      allow write: if request.auth != null;

      match /{document=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
